# CampusPulse+ Frontend Environment Variables
# Copy this file to .env.local for development
# Update VITE_API_BASE and VITE_SOCKET_URL with your backend URL

# Local development
VITE_API_BASE=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Production (update with actual deployed URLs)
# VITE_API_BASE=https://campuspulse-backend.onrender.com/api
# VITE_SOCKET_URL=https://campuspulse-backend.onrender.com