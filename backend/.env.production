# CampusPulse+ Production Environment Variables
# Add these to Render dashboard DIRECTLY (do NOT commit secrets)

PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://campuspulse-frontend.vercel.app

# Aiven MySQL (from Aiven dashboard)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-aiven-mysql-password
DB_NAME=campuspulse
DB_SSL_ENABLED=true

# JWT (MUST be strong random string - CHANGE THIS!)
JWT_SECRET=your-production-jwt-secret-min-32-chars-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Production settings
BOOTSTRAP_LOCAL_ADMIN=false
SMS_PROVIDER=console