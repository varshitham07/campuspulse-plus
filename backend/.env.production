# CampusPulse+ Production Environment Variables
# DO NOT commit this file. Add these to your Render dashboard directly.

PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://campuspulse-frontend.vercel.app

# Aiven MySQL Credentials (from Aiven dashboard)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-aiven-mysql-password
DB_NAME=campuspulse
DB_SSL_ENABLED=true

# JWT Secret (MUST be a strong random string - CHANGE THIS!)
JWT_SECRET=your-production-jwt-secret-min-32-chars-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# DO NOT bootstrap admin in production
BOOTSTRAP_LOCAL_ADMIN=false

# SMS Provider (configure after deployment)
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=CPPLUS